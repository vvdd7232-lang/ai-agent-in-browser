{
  "manifest_version": 3,
  "name": "AI Agent in Browser",
  "short_name": "AI Agent",
  "version": "0.1.0",
  "description": "Даёт обычному ИИ-чату в браузере доступ к локальному терминалу: находит блоки [EXECUTE] в ответах модели, выполняет их через программу-мост и возвращает вывод обратно в чат.",
  "homepage_url": "https://github.com/vvdd7232-lang/ai-agent-in-browser",

  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["parser.js", "adapters.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Agent in Browser"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
