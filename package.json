{
  "name": "ai-agent-in-browser",
  "version": "0.1.0",
  "description": "Даёт обычному ИИ-чату в браузере доступ к локальному терминалу: читает ответы модели, выполняет блоки [EXECUTE] и возвращает вывод обратно в чат.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ai-agent-in-browser": "bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "dev": "node bin/cli.js --port 7788",
    "icons": "node scripts/make-icons.js",
    "build:ext": "node scripts/build-extension.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "ai",
    "agent",
    "terminal",
    "browser-extension",
    "chatgpt",
    "claude",
    "gemini",
    "opencode"
  ],
  "dependencies": {},
  "devDependencies": {}
}
